{
  // Cloudflare-Worker-Konfiguration für die Next.js-App (@opennextjs/cloudflare).
  // Docs: https://opennext.js.org/cloudflare
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "allgaeu-wings",
  "main": ".open-next/worker.js",

  // Nötig für den Adapter: nodejs_compat + Compat-Date >= 2024-09-23, damit
  // Stripe und node:crypto auf dem Workers-Runtime laufen.
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],

  // Statische Assets (Bilder, Fonts, JS/CSS aus public/ und dem Build) werden
  // über dieses Binding ausgeliefert. Für die aktuell praktisch statische Seite
  // ist das das EINZIGE benötigte Binding — R2/KV/D1 kommen erst mit ihren
  // jeweiligen Phasen dazu (siehe unten und docs/01-architektur.md).
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": {
    "enabled": true
  },

  // Runtime-Vars (STRIPE_*, SITE_URL …) werden im Dashboard verwaltet;
  // keep_vars verhindert, dass jeder Deploy sie löscht.
  "keep_vars": true

  // ──────────────────────────────────────────────────────────────────────────
  // Zusatz-Bindings – erst reaktivieren, wenn die jeweilige Phase sie braucht.
  // Statische Bilder brauchen KEIN R2 (sie laufen über ASSETS oben).
  //
  // R2 (ab spürbarem ISR/revalidate) – OpenNext-Seiten-Cache. Anlegen:
  //   wrangler r2 bucket create allgaeu-wings-inc-cache
  // und in open-next.config.ts den r2IncrementalCache wieder aktivieren.
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "allgaeu-wings-inc-cache" }
  // ],
  //
  // KV (ab Stripe-Webhook, Phase Shop-Backend) – Webhook-Idempotenz. Anlegen:
  //   wrangler kv namespace create WEBHOOK_IDEMPOTENCY_KV
  // "kv_namespaces": [
  //   { "binding": "WEBHOOK_IDEMPOTENCY_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  // ],
  //
  // D1 (ab Gutschein-Lifecycle) – Gutscheine/Anfragen. Anlegen:
  //   wrangler d1 create allgaeu-wings
  // "d1_databases": [
  //   { "binding": "DB", "database_name": "allgaeu-wings", "database_id": "REPLACE_WITH_D1_DATABASE_ID" }
  // ]
  // ──────────────────────────────────────────────────────────────────────────
}
